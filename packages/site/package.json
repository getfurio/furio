{
  "name": "@getfurio/site",
  "version": "0.1.0",
  "private": true,
  "description": "The Furio map: a static site generated from model.json.",
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "@fontsource-variable/archivo": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@xyflow/react": "^12.12.0",
    "dompurify": "^3.4.16",
    "elkjs": "^0.12.0",
    "html-to-image": "^1.11.13",
    "lucide-react": "^1.49.0",
    "marked": "^18.1.0",
    "mermaid": "^12.0.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@getfurio/core": "workspace:*",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "vite": "^8.3.2"
  },
  "scripts": {
    "dev": "pnpm run model && vite",
    "model": "tsx --conditions=@getfurio/source ../cli/src/bin.ts build --workspace furio-demo --out public/model.json ../../examples/demo/shop-api ../../examples/demo/shop-web ../../examples/demo/platform",
    "build": "vite build",
    "preview": "pnpm run model && node -e \"fs.cpSync('public/model.json','dist/model.json')\" && vite preview",
    "typecheck": "tsc --noEmit"
  }
}
